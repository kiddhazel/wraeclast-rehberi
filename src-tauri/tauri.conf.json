{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wraeclast Rehberi",
  "version": "0.1.0",
  "identifier": "com.wraeclast.rehberi",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Wraeclast Rehberi",
        "width": 520,
        "height": 940,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Path of Exile ikinci ekran rehberi",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
